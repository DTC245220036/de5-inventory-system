[mysqld]
# Hardening MySQL Configuration
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-storage-engine = InnoDB

# Vô hiệu hóa đọc file cục bộ từ client để chống tấn công đọc file hệ thống
local_infile = 0

# Vô hiệu hóa symbolic links để ngăn chặn leo thang đặc quyền trên filesystem
symbolic-links = 0

# Giới hạn kết nối đồng thời để bảo vệ tài nguyên
max_connections = 150
max_connect_errors = 100

# Bật log truy vấn chậm để hỗ trợ giám sát và tối ưu hiệu năng
slow_query_log = 1
long_query_time = 2

[client]
default-character-set = utf8mb4
